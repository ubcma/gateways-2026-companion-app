# mp-backend (Better Auth lives at /api/auth/*)
NEXT_PUBLIC_BACKEND_URL="http://localhost:8080"
# Optional server-side override, e.g. a private network URL for the backend
BACKEND_URL="http://localhost:8080"

# ID of the Gateways event in mp-backend; only users registered for it get access.
# 65 is the test event in development; production uses 32.
GATEWAYS_EVENT_ID="65"

# Membership portal, linked for sign up, forgot password and event registration
NEXT_PUBLIC_PORTAL_URL="http://localhost:3000"
